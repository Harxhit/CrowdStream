# URL of the backend signaling server used for Socket.IO communication.
# Used for joining rooms, creating transports, producing media, and consuming media.
VITE_SIGNALING_URL=<your_signaling_url>

# Username used to authenticate with the TURN server.
VITE_TURN_USERNAME=<your_turn_username>

# Credential/password used to authenticate with the TURN server.
VITE_TURN_CREDENTIAL=<your_turn_credential>

# TURN server URL using UDP transport.
# Used when direct peer-to-peer connectivity is not possible.
VITE_TURN_UDP_URL=<your_turn_udp_url>

# TURN server URL using TCP transport.
# Acts as a fallback when UDP traffic is blocked by the network.
VITE_TURN_TCP_URL=<your_turn_tcp_url>

# TURN server URL using TLS (secure TURN).
# Used in restrictive networks that require encrypted relay traffic.
VITE_TURNS_TCP_URL=<your_turns_tcp_url>