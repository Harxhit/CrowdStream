# Port on which the Node.js server will listen
PORT=<your_port>

# Publicly reachable IP/domain announced to WebRTC clients.
# Usually your EC2 Elastic IP, public IPv4 address, or public domain.
ANNOUCED_IP=<your_announced_ip>

# Public IP address of the server.
# Used when the application needs to know its externally reachable address.
PUBLIC_IP=<your_public_ip>

# Minimum UDP port used by MediaSoup workers for RTP/RTCP traffic
RTC_MIN_PORT=<your_rtc_min_port>

# Maximum UDP port used by MediaSoup workers for RTP/RTCP traffic
RTX_MAX_PORT=<your_rtc_max_port>

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGINS=<your_cors_origins>

JWT_SECRET=<your_jwt_secret>

MONGO_DB_URL=<your_mongo_db_database_url>

ACCESS_TOKEN_EXPIRY=<expiry_time>

#Database name
DATABASE_NAME=CrowdStream