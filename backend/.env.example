```env
# ============================================================================
# Redis Configuration
# ============================================================================

# Redis Cluster host.
#
# Example:
# REDIS_HOST=127.0.0.1
REDIS_HOST=<redis_host>

# Redis Cluster startup node ports.
#
# These are only the startup nodes used by the client to discover the cluster.
# The client automatically discovers all remaining masters and replicas.
#
# Example:
# REDIS_PORT1=6379
# REDIS_PORT2=6380
# REDIS_PORT3=6381
REDIS_PORT1=<redis_port_1>
REDIS_PORT2=<redis_port_2>
REDIS_PORT3=<redis_port_3>
```
# ============================================================================
# Server Configuration
# ============================================================================

# Port on which the Node.js server will listen.
PORT=<your_port>

# Publicly reachable IP/domain announced to WebRTC clients.
# Usually your EC2 Elastic IP, public IPv4 address, or public domain.
ANNOUCED_IP=<your_announced_ip>

# Public IP address of the server.
# Used when the application needs to know its externally reachable address.
PUBLIC_IP=<your_public_ip>

# ============================================================================
# MediaSoup Configuration
# ============================================================================

# Minimum UDP port used by MediaSoup workers for RTP/RTCP traffic.
RTC_MIN_PORT=<your_rtc_min_port>

# Maximum UDP port used by MediaSoup workers for RTP/RTCP traffic.
RTX_MAX_PORT=<your_rtc_max_port>

# Initial number of MediaSoup workers created when the application starts.
#
# Recommendations:
# - Should NOT exceed the number of available CPU cores.
# - Leave CPU headroom for other services (Node.js, Redis, FFmpeg, Nginx,
#   MongoDB, OS processes, etc.).
#
# Example:
#   Machine: 8 CPU cores
#   MEDIASOUP_WORKER=3
MEDIASOUP_WORKER=<initial_worker_count>

# Maximum number of MediaSoup workers that can exist after dynamic scaling.
#
# Recommendations:
# - Must be greater than or equal to MEDIASOUP_WORKER.
# - Must NOT exceed the available CPU cores on the machine.
#
# Example:
#   Machine: 8 CPU cores
#   MEDIASOUP_MAX_WORKERS=6
MEDIASOUP_MAX_WORKERS=<maximum_worker_count>

# Maximum number of users allowed on a single MediaSoup worker before
# attempting to create an additional worker (if the maximum worker limit
# has not been reached).
#
# Example:
#   WORKER_THRESHOLD=500
WORKER_THRESHOLD=<maximum_users_per_worker>

# ============================================================================
# Application Configuration
# ============================================================================

# Allowed CORS origins (comma-separated if multiple).
CORS_ORIGINS=<your_cors_origins>

JWT_SECRET=<your_jwt_secret>

ACCESS_TOKEN_EXPIRY=<expiry_time>

# ============================================================================
# Database Configuration
# ============================================================================

MONGO_DB_URL=<your_mongodb_connection_string>

# Database name.
DATABASE_NAME=<your_database_name>

# ============================================================================
# TURN Server Configuration
# ============================================================================

TURN_SECRET=<your_turn_secret>

# Lifetime (in seconds) for generated TURN credentials.
TURN_TTL=<turn_credentials_ttl_seconds>

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis Cluster host.
#
# Example:
# REDIS_HOST=127.0.0.1
REDIS_HOST=<redis_host>

# Redis Cluster startup node ports.
#
# These are only the startup nodes used by the client to discover the cluster.
# The client automatically discovers all remaining masters and replicas.
#
# Example:
# REDIS_PORT1=6379
# REDIS_PORT2=6380
# REDIS_PORT3=6381
REDIS_PORT1=<redis_port_1>
REDIS_PORT2=<redis_port_2>
REDIS_PORT3=<redis_port_3>

